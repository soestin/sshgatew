# Copy to .env next to compose.yaml. Docker Compose loads it automatically.
SSHGATEW_ADMIN=admin
SSHGATEW_ADMIN_KEY_FILE=./admin.pub
SSHGATEW_PORT=2222
SSHGATEW_VERSION=latest

# Optional OIDC device login and account linking.
SSHGATEW_OIDC_ENABLED=false
SSHGATEW_OIDC_ISSUER=https://identity.example.com/application/o/sshgatew/
SSHGATEW_OIDC_CLIENT_ID=sshgatew
SSHGATEW_OIDC_CLIENT_SECRET=
SSHGATEW_OIDC_USERNAME_CLAIM=preferred_username
SSHGATEW_OIDC_SCOPES=openid profile email
SSHGATEW_OIDC_LOGIN_TIMEOUT=5m
